# Subscription auth for the in-container `claude` CLI.
# Generate with:  claude setup-token   (requires a Pro/Max subscription)
# This is the ONLY secret the worker container receives.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: higher rate limits for the find-docs / context7 skill.
# CONTEXT7_API_KEY=

# NOTE: GH_TOKEN is intentionally NOT here. The worker has no GitHub access.
# All GitHub mutations (merge, comment, close, release upload) run on the HOST
# using your normal `gh auth` / git credentials.
