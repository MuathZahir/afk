{
  "baseBranch": "master",
  "push": false,
  "maxParallel": 2,
  "maxIssuesPerRun": 5,
  "issueTimeoutMin": 30,
  "model": "opus",

  "setup": "npm ci",
  "typecheck": "npm run typecheck",
  "test": "npm run test",

  "labels": {
    "ready": "ready-for-agent",
    "human": "ready-for-human"
  }
}
